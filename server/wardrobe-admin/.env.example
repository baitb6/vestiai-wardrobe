# 复制为 /etc/wardrobe-admin.env，按实际填写；生产务必改 WM_SECRET
WM_DB=/var/lib/wardrobe-admin/wardrobe.db
WM_PORT=8787
WM_SECRET=请用-python3-c-"import secrets;print(secrets.token_urlsafe(48))"-生成
WM_DEV_CODE=0
WM_BOOTSTRAP_TOKEN=
WM_ALLOW_ORIGINS=https://ai.slongb.xyz

# 邮箱验证码（不填则验证码回显在页面上，仅用于内测）
WM_SMTP_HOST=
WM_SMTP_PORT=465
WM_SMTP_USER=
WM_SMTP_PASS=
WM_SMTP_FROM=

# 模型 API Key 在管理后台里直接填写，服务端用 WM_SECRET 加密后存库，
# 不需要在这里配置任何密钥变量。
